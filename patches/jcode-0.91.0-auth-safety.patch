+#[test]
+fn authentication_lock_serializes_separate_processes() {
+    let marker = "JCODE_AUTH_LOCK_TEST_CHILD";
+    if let Some(root) = std::env::var_os(marker) {
+        let root = std::path::PathBuf::from(root);
+        std::fs::write(root.join("started"), "started").unwrap();
+        let _guard = super::account_store::file_lock(&root.join("auth.json")).unwrap();
+        std::fs::write(root.join("entered"), "entered").unwrap();
+        return;
+    }
+    let temporary = tempfile::tempdir().unwrap();
+    let root = temporary.path();
+    let guard = super::account_store::file_lock(&root.join("auth.json")).unwrap();
+    let mut child = std::process::Command::new(std::env::current_exe().unwrap())
+        .args([
+            "--exact",
+            "auth::guarded_auth_tests::authentication_lock_serializes_separate_processes",
+        ])
+        .env(marker, root)
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .spawn()
+        .unwrap();
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(3);
+    while !root.join("started").exists() && std::time::Instant::now() < deadline {
+        std::thread::sleep(std::time::Duration::from_millis(10));
+    }
+    assert!(root.join("started").exists());
+    std::thread::sleep(std::time::Duration::from_millis(50));
+    assert!(!root.join("entered").exists());
+    drop(guard);
+    while std::time::Instant::now() < deadline {
+        if let Some(status) = child.try_wait().unwrap() {
+            assert!(status.success());
+            assert!(root.join("entered").exists());
+            return;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(10));
+    }
+    child.kill().unwrap();
+    child.wait().unwrap();
+    panic!("Owned authentication lock fixture did not finish");
+}
