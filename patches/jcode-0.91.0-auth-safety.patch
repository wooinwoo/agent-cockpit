+                    .is_none_or(|id| extract_account_id(id_token).as_deref() == Some(id))
+                    && account
+                        .email
+                        .as_deref()
+                        .is_none_or(|email| extract_email(id_token)
+                            .is_some_and(|actual| actual.eq_ignore_ascii_case(email))),
+                "Refreshed OpenAI identity changed; existing account was preserved"
+            );
+        }
+        account.access_token = tokens.access_token.clone();
+        account.refresh_token = tokens.refresh_token.clone();
+        if tokens.id_token.is_some() {
+            account.id_token = tokens.id_token.clone();
+        }
+        account.expires_at = Some(tokens.expires_at);
+        Ok(true)
+    })
 }
 
