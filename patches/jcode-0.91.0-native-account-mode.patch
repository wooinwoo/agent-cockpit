+pub fn save_verified_initial_openai(
+    label: &str,
+    expected_email: &str,
+    tokens: &OAuthTokens,
+) -> Result<()> {
+    let actual = tokens
+        .id_token
+        .as_deref()
+        .and_then(super::codex::extract_email);
+    super::account_store::verify_expected_email(expected_email, actual.as_deref())?;
+    super::codex::replace_existing_tokens(label, Some(expected_email), None, None, tokens)?;
+    Ok(())
+}
+
+/// Refresh only the one account owned by an isolated Cockpit profile; never export tokens.
+pub async fn refresh_guarded_account(
+    provider: &str,
+    label: &str,
+    expected_email: &str,
+    force: bool,
+) -> Result<bool> {
+    anyhow::ensure!(
+        super::account_store::account_only(),
+        "Isolated native account mode is required"
+    );
+    match provider {
+        "claude" => {
+            let accounts = claude_auth::list_accounts()?;
+            anyhow::ensure!(
+                accounts.len() == 1,
+                "Exactly one native Claude account is required"
+            );
+            let account = &accounts[0];
+            super::account_store::verify_isolated_identity(account.email.as_deref(),None)?;
+            anyhow::ensure!(account.label == label, "Selected native account changed");
+            super::account_store::verify_expected_email(expected_email, account.email.as_deref())?;
+            anyhow::ensure!(
+                !account.access.is_empty() && !account.refresh.is_empty(),
+                "Native account login required"
+            );
+            if !force && account.expires > chrono::Utc::now().timestamp_millis() + 300_000 {
+                return Ok(false);
+            }
+            refresh_claude_tokens_for_account(&account.refresh, label).await?;
+        }
+        "openai" => {
+            let accounts = super::codex::list_accounts()?;
+            anyhow::ensure!(
+                accounts.len() == 1,
+                "Exactly one native OpenAI account is required"
+            );
+            let account = &accounts[0];
+            super::account_store::verify_isolated_identity(account.email.as_deref(),account.account_id.as_deref())?;
+            anyhow::ensure!(account.label == label, "Selected native account changed");
+            super::account_store::verify_expected_email(expected_email, account.email.as_deref())?;
+            anyhow::ensure!(
+                !account.access_token.is_empty()
+                    && !account.refresh_token.is_empty()
+                    && account
+                        .account_id
+                        .as_deref()
+                        .is_some_and(|id| !id.is_empty()),
+                "Native account login required"
+            );
+            if !force
+                && account.expires_at.is_some_and(|expires| {
+                    expires > chrono::Utc::now().timestamp_millis() + 300_000
+                })
+            {
+                return Ok(false);
+            }
+            refresh_openai_tokens_for_account(&account.refresh_token, label).await?;
+        }
+        _ => anyhow::bail!("Unsupported native account provider"),
+    }
+    Ok(true)
 }
 
