+/// Serialize a complete read/modify/write across login and daemon processes.
+pub fn with_file_lock<T>(path: &std::path::Path, action: impl FnOnce() -> Result<T>) -> Result<T> {
+    let _guard = file_lock(path)?;
+    action()
+}
+
+pub fn file_lock(path: &std::path::Path) -> Result<std::fs::File> {
+    if let Some(parent) = path.parent() {
+        crate::storage::ensure_dir(parent)?;
+    }
+    let mut options = std::fs::OpenOptions::new();
+    options.read(true).write(true).create(true).truncate(false);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options
+            .mode(0o600)
+            .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK);
+    }
+    let lock = options.open(path.with_extension("lock"))?;
+    let metadata = lock.metadata()?;
+    anyhow::ensure!(
+        metadata.is_file(),
+        "Authentication lock is not a regular file"
+    );
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        anyhow::ensure!(
+            metadata.uid() == unsafe { libc::geteuid() }
+                && metadata.mode() & 0o077 == 0
+                && metadata.nlink() == 1,
+            "Authentication lock is not private"
+        );
+    }
+    lock.lock()?;
+    Ok(lock)
+}
+
+pub fn verify_expected_email(expected: &str, actual: Option<&str>) -> Result<()> {
+    anyhow::ensure!(
+        !expected.trim().is_empty()
+            && expected.len() <= 254
+            && !expected.chars().any(char::is_control),
+        "Expected account email is invalid"
+    );
+    anyhow::ensure!(
+        actual.is_some_and(|email| email.trim().eq_ignore_ascii_case(expected.trim())),
+        "The authenticated account does not match the selected account; existing credentials were preserved"
+    );
+    Ok(())
+}
