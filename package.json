{
  "name": "agent-cockpit",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/start-cockpit.mjs",
    "start:node": "node server.js",
    "ui:build": "tailwindcss -i ./ui/cockpit.css -o ./css/cockpit.css --minify",
    "ui:watch": "tailwindcss -i ./ui/cockpit.css -o ./css/cockpit.css --watch",
    "test": "node --test tests/lib/*.test.js tests/routes/*.test.js",
    "test:watch": "node --watch-path=lib --watch-path=routes --watch-path=tests --test tests/lib/*.test.js tests/routes/*.test.js",
    "bundle": "ncc build server.js -o dist --minify",
    "build": "npm run ui:build && node scripts/build-installer.js",
    "tauri": "tauri",
    "test:e2e": "node scripts/e2e-wheel-test.mjs",
    "test:integration": "node scripts/verify-portfolio.mjs",
    "demo:capture": "node scripts/verify-portfolio.mjs --capture"
  },
  "dependencies": {
    "@1jehuang/jcode-sdk": "1.1.0",
    "@langchain/core": "^1.1.26",
    "@langchain/google-genai": "^2.1.19",
    "@langchain/langgraph": "^1.1.5",
    "msedge-tts": "^2.0.4",
    "node-pty": "^1.1.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^10.0.3",
    "jsdom": "^24.1.3",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3"
  }
}
