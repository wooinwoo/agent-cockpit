+/// Replace an existing account only; stale refreshes never recreate or overwrite a newer login.
+pub fn replace_existing_tokens(
+    label: &str,
+    expected_email: Option<&str>,
+    expected_refresh: Option<&str>,
+    tokens: &super::oauth::OAuthTokens,
+) -> Result<bool> {
+    edit_auth(|auth| {
+        if let Some(email) = expected_email {
+            anyhow::ensure!(
+                auth.anthropic_accounts
+                    .iter()
+                    .filter(|a| a
+                        .email
+                        .as_deref()
+                        .is_some_and(|e| e.trim().eq_ignore_ascii_case(email.trim())))
+                    .count()
+                    == 1,
+                "Stored Claude account identity is ambiguous"
+            );
+        }
+        let account = auth
+            .anthropic_accounts
+            .iter_mut()
+            .find(|a| a.label == label)
+            .ok_or_else(|| {
+                anyhow::anyhow!("Stored Claude account changed; retry authentication")
+            })?;
+        if let Some(email) = expected_email {
+            anyhow::ensure!(
+                account
+                    .email
+                    .as_deref()
+                    .is_some_and(|e| e.trim().eq_ignore_ascii_case(email.trim())),
+                "Stored Claude account identity changed"
+            );
+        }
+        if expected_refresh.is_some_and(|refresh| account.refresh != refresh) {
+            return Ok(false);
+        }
+        account.access = tokens.access_token.clone();
+        account.refresh = tokens.refresh_token.clone();
+        account.expires = tokens.expires_at;
+        if !tokens.scopes.is_empty() {
+            account.scopes = tokens.scopes.clone();
+        }
+        Ok(true)
+    })
 }
 
 // ---- Credential loading (used by provider) ----
 
+/// Preserve the existing external-auth import path without recreating a deleted native account.
+pub(crate) fn store_initial_external_refresh(tokens: &super::oauth::OAuthTokens) -> Result<()> {
+    edit_auth(|auth| {
+        anyhow::ensure!(
+            auth.anthropic_accounts.is_empty(),
+            "Claude authentication changed during external refresh"
+        );
+        let label = primary_account_label();
+        auth.anthropic_accounts.push(AnthropicAccount {
+            label: label.clone(),
+            email: None,
+            access: tokens.access_token.clone(),
+            refresh: tokens.refresh_token.clone(),
+            expires: tokens.expires_at,
+            subscription_type: None,
+            scopes: tokens.scopes.clone(),
+        });
+        auth.active_anthropic_account = Some(label);
+        Ok(())
+    })
+}
