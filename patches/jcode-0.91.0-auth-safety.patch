+/// OAuth rotation must also serialize with another process using this store.
+pub async fn cross_process_single_flight<T, Reload, Fresh, Refresh, Fut>(
+    key: String,
+    reload: Reload,
+    already_refreshed: Fresh,
+    refresh: Refresh,
+) -> anyhow::Result<T>
+where
+    Reload: FnOnce() -> Option<T>,
+    Fresh: FnOnce(&T) -> bool,
+    Refresh: FnOnce(Option<T>) -> Fut,
+    Fut: std::future::Future<Output = anyhow::Result<T>>,
+{
+    use sha2::{Digest, Sha256};
+    let path = crate::storage::jcode_dir()?
+        .join(format!("refresh-{:x}.json", Sha256::digest(key.as_bytes())));
+    let _guard =
+        tokio::task::spawn_blocking(move || crate::auth::account_store::file_lock(&path)).await??;
+    single_flight(key, reload, already_refreshed, refresh).await
+}
