index 0000000..eab5bae
--- /dev/null
+++ b/crates/jcode-base/src/account_usage_records.rs
@@ -0,0 +1,177 @@
+//! Request-time account identity and terminal usage. No credentials or content.
+use serde::{Deserialize, Serialize};
+use std::{
+    fs::OpenOptions,
+    io::{Read, Seek, SeekFrom, Write},
+    path::Path,
+};
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Record {
+    pub schema: u32,
+    pub id: String,
+    pub timestamp: String,
+    pub session: Option<String>,
+    pub provider: String,
+    pub email: Option<String>,
+    pub account_id: Option<String>,
+    pub requested_model: String,
+    pub model: Option<String>,
+    pub service_tier: Option<String>,
+    pub cache_ttl: String,
+    pub input_tokens: Option<u64>,
+    pub output_tokens: Option<u64>,
+    pub cache_read_input_tokens: Option<u64>,
+    pub cache_creation_input_tokens: Option<u64>,
+}
+
+impl Record {
+    pub fn capture(provider: &str, email: Option<String>, model: &str, cache_ttl: &str) -> Self {
+        Self {
+            schema: 1,
+            id: uuid::Uuid::new_v4().to_string(),
+            timestamp: chrono::Utc::now().to_rfc3339(),
+            session: crate::logging::current_context_snapshot().session,
+            provider: provider.into(),
+            email,
+            account_id: None,
+            requested_model: model.into(),
+            model: None,
+            service_tier: None,
+            cache_ttl: cache_ttl.into(),
+            input_tokens: None,
+            output_tokens: None,
+            cache_read_input_tokens: None,
+            cache_creation_input_tokens: None,
+        }
+    }
+
+    /// Capture only response metadata, never output text or tool payloads.
+    pub fn response_metadata(&mut self, response: &serde_json::Value) {
+        if let Some(model) = response.get("model").and_then(serde_json::Value::as_str) {
+            self.model = Some(model.into());
+        }
+        if let Some(tier) = response
+            .get("service_tier")
+            .and_then(serde_json::Value::as_str)
+        {
+            self.service_tier = Some(tier.into());
+        }
+    }
+
+    pub fn persist(&self) -> anyhow::Result<()> {
+        self.append(&crate::storage::jcode_dir()?.join("account_usage.jsonl"))
+    }
+
+    fn append(&self, path: &Path) -> anyhow::Result<()> {
+        let mut bytes = serde_json::to_vec(self)?;
+        anyhow::ensure!(bytes.len() < 4096, "account usage metadata too large");
+        bytes.push(b'\n');
+        let mut options = OpenOptions::new();
+        options.read(true).append(true).create(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            options
+                .mode(0o600)
+                .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK);
+        }
+        let mut file = options.open(path)?;
+        let meta = file.metadata()?;
+        anyhow::ensure!(meta.is_file(), "account usage path is not a regular file");
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::MetadataExt;
+            anyhow::ensure!(
+                meta.uid() == unsafe { libc::geteuid() }
+                    && meta.mode() & 0o077 == 0
+                    && meta.nlink() == 1,
+                "account usage file is not private"
+            );
+        }
+        // Lock the append-only inode; no process replaces this file.
+        file.lock()?;
+        if file.metadata()?.len() > 0 {
+            file.seek(SeekFrom::End(-1))?;
+            let mut last = [0];
+            file.read_exact(&mut last)?;
+            if last[0] != b'\n' {
+                file.write_all(b"\n")?;
+            }
+        }
+        file.write_all(&bytes)?;
+        file.sync_data()?;
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn append_preserves_partial_records_and_serializes_concurrent_writers() {
+        let temp = tempfile::tempdir().unwrap();
+        let path = temp.path().join("account_usage.jsonl");
+        let mut initial = OpenOptions::new();
+        initial.write(true).create_new(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            initial.mode(0o600);
+        }
+        initial.open(&path).unwrap().write_all(b"{partial").unwrap();
+        std::thread::scope(|scope| {
+            for _ in 0..8 {
+                let path = &path;
+                scope.spawn(move || {
+                    Record::capture(
+                        "claude",
+                        Some("test@example.com".into()),
+                        "claude-opus-5-5",
+                        "5m",
+                    )
+                    .append(path)
+                    .unwrap()
+                });
+            }
+        });
+        let text = std::fs::read_to_string(&path).unwrap();
+        assert!(text.starts_with("{partial\n"));
+        let records: Vec<Record> = text
+            .lines()
+            .skip(1)
+            .map(|s| serde_json::from_str(s).unwrap())
+            .collect();
+        assert_eq!(records.len(), 8);
+        assert_eq!(
+            records
+                .iter()
+                .map(|r| &r.id)
+                .collect::<std::collections::HashSet<_>>()
+                .len(),
+            8
+        );
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::MetadataExt;
+            assert_eq!(std::fs::metadata(&path).unwrap().mode() & 0o777, 0o600);
+        }
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn refuses_symlinks_and_public_files() {
+        use std::os::unix::fs::{PermissionsExt, symlink};
+        let temp = tempfile::tempdir().unwrap();
+        let target = temp.path().join("target");
+        std::fs::write(&target, "untouched").unwrap();
+        std::fs::set_permissions(&target, std::fs::Permissions::from_mode(0o644)).unwrap();
+        let link = temp.path().join("link");
+        symlink(&target, &link).unwrap();
+        let record = Record::capture("openai", None, "gpt-6.1-sol", "unknown");
+        assert!(record.append(&link).is_err());
+        assert!(record.append(&target).is_err());
+        assert_eq!(std::fs::read_to_string(target).unwrap(), "untouched");
+    }
+}
